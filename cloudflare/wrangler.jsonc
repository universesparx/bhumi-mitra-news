{
  // Dedicated, non-deployed news Worker. Do not reuse AI Land Advisor bindings.
  "name": "bhumi-mitra-news",
  "main": "src/index.js",
  "compatibility_date": "2026-10-31",
  "workers_dev": false,
  "vars": {
    "NEWS_PUBLISHING_ENABLED": "false",
    "NEWS_COLLECTION_ENABLED": "false",
    "EDITORIAL_WRITES_ENABLED": "false",
    "EDITORIAL_IMAGE_WRITES_ENABLED": "false",
    "AUTH_ENABLED": "false"
  }
}
